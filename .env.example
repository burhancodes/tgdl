# --- required ---
TG_API_ID=12345678
TG_API_HASH=your_api_hash_from_my_telegram_org
TG_BOT_TOKEN=123456:ABC-your-bot-token-from-botfather

# --- access control & authorization (security) ---
# Telegram user ID of the bot owner. Required for /settings and owner actions.
# If unset, falls back to the first ID in AUTHORIZED_USER_IDS.
OWNER_ID=12345678
AUTHORIZED_USER_IDS=12345678,98765432
# Optional encryption key for encrypting secrets in DATA_DIR/settings.json with AES-256-GCM.
SETTINGS_ENCRYPTION_KEY=

# --- general & network binding ---
# When true, bot /set commands also update matching KEY=value lines in .env atomically.
SETTINGS_WRITE_ENV=false
# Source IP address to bind outbound sockets to (optional).
SOURCE_ADDRESS=
# Force IPv6 resolution and outbound connections.
FORCE_IPV6=false

# --- safeguards & limits ---
MAX_JOBS_PER_CHAT=3
MAX_TOTAL_DOWNLOADS_BYTES=
GLOBAL_DOWNLOAD_SPEED_LIMIT=20M
MIN_FREE_DISK_BYTES=2147483648

# --- heavy work concurrency & tool limits ---
TG_MAX_CONCURRENT_HEAVY=1
EXTRACT_THREADS=2
ARCHIVE_THREADS=2
ARCHIVE_ZIP_LEVEL=1
MAX_EXTRACT_BYTES=21474836480
MAX_EXTRACT_FILES=200000

# --- memory limit & profiling ---
# TGDL_MEMORY_LIMIT_MB=2400
# Set TGDL_PPROF=1 to expose net/http/pprof on 127.0.0.1:6060
TGDL_PPROF=0

# --- docker container resource settings (used by docker-compose) ---
BOTAPI_MEM=3g
BOTAPI_CPUS=2
TGDL_MEM=3g
TGDL_CPUS=2
GOMEMLIMIT=2400MiB

# --- optional (required for /pdup & /gofile) ---
PIXELDRAIN_API_KEY=your_pixeldrain_api_key_here
PIXELDRAIN_DOMAIN=pixeldrain.com
GOFILE_API_KEY=your_gofile_api_key_here
# Optional custom bypass host or proxy for GoFile API requests.
GOFILE_BYPASS_HOST=
ALLOW_SHARED_UPLOAD_KEYS=false
ALLOW_PRIVATE_NETWORK_URLS=false

# --- storage (defaults are fine for most setups) ---
DATA_DIR=./data
AUTH_DIR=./auth
LOG_DIR=./logs

# --- google drive credentials ---
GDRIVE_TOKEN_PATH=./auth/token.json
GDRIVE_ACCOUNTS_DIR=./auth/accounts
USE_SERVICE_ACCOUNTS=true

# --- mega credentials ---
# Optional MEGA account credentials to bypass bandwidth quotas.
MEGA_EMAIL=
MEGA_PASSWORD=

# --- downloader pacing & timeouts ---
# Timeout for HLS stream manifest and segment downloads in seconds.
HLS_DOWNLOAD_TIMEOUT=120
# gallery-dl pacing (tune down if bunkr still throttles you)
GDL_SLEEP_MIN=1.5
GDL_SLEEP_MAX=4.0
GDL_SLEEP_REQUEST=1-3
GDL_RETRIES=4
GDL_MAX_RUN_RETRIES=3
GDL_BACKOFF_BASE_S=30
GDL_BACKOFF_MULTIPLIER=2.5
# cyberdrop-dl pacing & retry settings
CDL_RETRIES=4
CDL_MAX_RUN_RETRIES=3
CDL_BACKOFF_BASE_S=30
CDL_BACKOFF_MULTIPLIER=2.5

# --- telegram upload pacing & batching ---
TG_UPLOAD_DELAY_MIN=3.0
TG_UPLOAD_DELAY_MAX=5.0
TG_BATCH_SIZE=15
TG_BATCH_COOLDOWN_S=20
TG_UPLOAD_MAX_RETRIES=3
TG_MAX_CONCURRENT_DOWNLOADS=1
TG_MAX_CONCURRENT_UPLOADS=1
TG_ALBUM_MAX_BYTES=67108864
PIN_STATUS_MESSAGE=true

# --- file renaming ---
RENAME_MAX_BATCH=30
RENAME_SESSION_TTL=30m

# --- self-hosted telegram-bot-api server (--local mode) ---
# TG_BOT_API_URL=http://telegram-bot-api:8081
# TG_BOT_API_DATA_DIR=/var/lib/telegram-bot-api
# When telegram-bot-api runs with --local and shares the data directory, map host prefix
# to container prefix to send file:/// paths directly instead of streaming over HTTP.
# Format: hostprefix=containerprefix
# TG_BOT_API_LOCAL_DIR_MAP=/app/data=/app/data

# --- torrent & search (Magnetio JSON-RPC sidecar & aria2) ---
TORRENT_TIMEOUT=120
SEARCH_LIMIT=300
MAGNETIO_RPC_URL=http://magnetio-scraper:8080/rpc
MAGNETIO_RPC_SECRET=your_rpc_secret_here
ARIA_MAX_CONCURRENT_DOWNLOADS=1

# --- observability ---
# LOG_LEVEL choices: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=text
# Show live host CPU and RAM metrics on active job status cards.
SHOW_SYSTEM_STATS_ON_JOB_CARD=false
